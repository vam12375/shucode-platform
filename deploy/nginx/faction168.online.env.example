# 仅把以下非秘密配置合并到服务器已有 .env，不要用本文件覆盖整个 .env。
# 不改 PLATFORM_SECRET_KEY、POSTGRES_PASSWORD、上游密钥和现有 IMAGE_TAG。
PUBLIC_API_ORIGIN=https://api.faction168.online
PUBLIC_APP_ORIGIN=https://console.faction168.online
PUBLIC_CONSOLE_ORIGIN=https://console.faction168.online
GATEWAY_BASE_URL=https://gw.faction168.online
# 仅当原本没有有效分发地址且已确认 api 直出 Release 时才设置；否则保留原值。
# RELEASE_BASE_URL=https://api.faction168.online
# 不因域名切换改变原有网关协议；以下仅为 OpenAI 模式示例。
# GATEWAY_API_TYPE=openai-chat-completions
CONSOLE_ALLOWED_HOSTS=console.faction168.online
# 登录/授权在 console 同源，Cookie 不扩散到整个主域。
COOKIE_DOMAIN=

# 宿主 Nginx 反代这些 published ports，禁止公网绕过 HTTPS 入口。
# 生产覆写强制回环；两个 HOST_IP 仅用于基础编排或兼容旧编排。
API_HOST_IP=127.0.0.1
GATEWAY_HOST_IP=127.0.0.1
API_HOST_PORT=8787
GATEWAY_HOST_PORT=8788

# 部署后用 docker inspect 取各容器网络 Gateway，并检查实际 TCP 对端。
# 每个变量填精确 IP（可逗号分隔），不能填 CIDR、0.0.0.0 或泛信任私网。
# 宿主访问 published loopback 时，容器经常看到网桥 Gateway，而不是 127.0.0.1。
# API_TRUSTED_PROXY_IPS=127.0.0.1,<api 容器的实际网桥 Gateway>
# GATEWAY_TRUSTED_PROXY_IPS=127.0.0.1,<gateway 容器的实际网桥 Gateway>
# CF 地址先在 Nginx 恢复；应用不要直接信任 CF-Connecting-IP。
TRUST_CF_CONNECTING_IP=
