# 逐项合并到服务器现有 .env，保留原密钥、IMAGE_TAG、数据库与上游配置。
PUBLIC_API_ORIGIN=https://api.mendao.chat
PUBLIC_APP_ORIGIN=https://console.mendao.chat
PUBLIC_CONSOLE_ORIGIN=https://console.mendao.chat
GATEWAY_BASE_URL=https://gw.mendao.chat
CONSOLE_ALLOWED_HOSTS=console.mendao.chat
SETUP_ALLOWED_HOSTS=console.mendao.chat
COOKIE_DOMAIN=

# PUBLIC_MEDIA_CDN_ORIGIN 继续使用 https://cdn.hzyaoshi.com；仅在 CDN 管理中将源站、回源 Host 与 SNI 指向 api.mendao.chat。
# RELEASE_BASE_URL 留空时跟随 PUBLIC_API_ORIGIN；若已有独立分发地址则保留。
# 保留 GATEWAY_API_TYPE 与两个 *_TRUSTED_PROXY_IPS。
# 若启用了 Turnstile，先在站点允许域名中加入 console.mendao.chat。
