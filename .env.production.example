# 生产环境 .env 模板 —— 放到服务器 /opt/shucode-platform/.env（权限 600，不进 git）。
#
# 服务器一次性准备步骤：
#   1. 安装 Docker（含 compose 插件）：curl -fsSL https://get.docker.com | sh
#   2. 登录 ghcr.io（私有镜像）：docker login ghcr.io
#      用户名 = GitHub 用户名；密码 = 勾选 read:packages 的 classic PAT
#   3. 按本文件填好 .env，密钥用下面命令生成：
#        PLATFORM_SECRET_KEY=$(openssl rand -base64 32)
#        POSTGRES_PASSWORD=$(openssl rand -hex 16)
#        BOOTSTRAP_SECRET=$(openssl rand -hex 24)
#   4. 使用宿主机 Nginx 提供 HTTPS（见 deploy/nginx/README.md）。生产编排已将
#      api/gateway 固定绑定 127.0.0.1；首次切换前先配置并验证 Nginx 入口。
#      初始化 root 经 HTTPS 或 SSH 转发/私网完成。
#   5. 部署后打开控制台创建唯一 root（首次初始化需要 x-bootstrap-secret），创建成功后
#      删除 BOOTSTRAP_SECRET 并重启 api。云防火墙只放行 22 / 80 / 443；8787/8788
#      和 5432 一律不对公网放行。
#
# 注意：IP 直连（无域名、无 HTTPS）是未定稿的临时形态，登录口令、会话与上游 key
# 都会明文过网；域名与 HTTPS 定稿后必须同步更新 PUBLIC_API_ORIGIN /
# PUBLIC_APP_ORIGIN / GATEWAY_BASE_URL，并检查 Secure cookie、CORS 与登录跳转。

# ---- API（控制面） ----
PORT=8787
# 容器内地址由 docker-compose.prod.yml 覆盖为 postgres:5432，这里仅本地排障用。
DATABASE_URL=postgres://mendao:CHANGE_ME@localhost:5432/mendao
MEMORY_DB=
# 客户端与控制台访问的对外地址（占位域名；替换为实际 HTTPS 域名）。
# 过渡期若仍用 IP 直连，必须清楚口令/会话/上游 key 会明文过网，仅限临时。
PUBLIC_API_ORIGIN=https://api.example.com
PUBLIC_APP_ORIGIN=https://api.example.com
# 32 字节 base64：openssl rand -base64 32；api 与 gateway 读同一个 .env，天然同值
PLATFORM_SECRET_KEY=
# 无域名留空（跨子域共享 Cookie 时才需要）
COOKIE_DOMAIN=
# 网关公网地址，写入用户级下发的 provider api.baseUrl
GATEWAY_BASE_URL=https://gw.example.com
GATEWAY_API_TYPE=openai-chat-completions
# 客户端要求 https；与公开 API 同域时填 https://api.example.com，其余留空回落内置配置
RELEASE_BASE_URL=
# 控制台由 api 同源托管，无需设置
CONSOLE_DIST_DIR=
PUBLIC_CONSOLE_ORIGIN=
# 填写应用实际看到的 Nginx TCP 对端；Docker 转发后可能是网桥 gateway。
# 必须实测精确 IP，不能因 Nginx 连接 127.0.0.1 就直接信任该地址。
API_TRUSTED_PROXY_IPS=
# 仅当源站只能经 Cloudflare（Tunnel 或防火墙只放行 CF 回源）时设为 1；
# 本仓库 Nginx 配置负责恢复 CF 来源并清洗 XFF，此项保持空。
TRUST_CF_CONNECTING_IP=
# 设备凭据最长寿命（天），0 = 不按年龄过期（仍可随时吊销）；建议 90。
DEVICE_TOKEN_TTL_DAYS=0
# 管理面只允许在指定 Host 访问（例如 console.example.com）；同域部署留空。
# 与边缘 Access/防火墙配合，确保公开 API 域名无法绕到 /console。
CONSOLE_ALLOWED_HOSTS=
# 首次初始化接口（/console/api/setup/*）的 Host 白名单；非空时只在这些 Host 可达。
# 建议指向仅经 Access/VPN 可达的专用初始化域名；留空则与 /console 同域可见。
SETUP_ALLOWED_HOSTS=
# Cloudflare Turnstile 登录人机验证（可选）。两个 key 必须同时配置，留空则不启用。
# 在 Cloudflare Dashboard → Turnstile 创建站点，域名填控制台域名（如 console.example.com）；
# site key 会通过 /console/api/public-config 下发，secret key 只留在服务端。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 可选：覆盖 siteverify 地址；生产留空使用 Cloudflare 官方地址。
TURNSTILE_VERIFY_URL=
# 首次 root 初始化口令；生成后只在初始化时使用，建议初始化成功后删除并重启。
BOOTSTRAP_SECRET=
# 生产保持空：供应商地址强制 https，且默认禁止出站访问私网/回环地址。
ALLOW_INSECURE_UPSTREAM_URLS=
UPSTREAM_ALLOW_PRIVATE_NETWORKS=
# 由 docker-compose.yml 自动注入(redis://redis:6379/0);此处留空即可
REDIS_URL=

# ---- Gateway（模型网关） ----
GATEWAY_PORT=8788
# 端口直连保持空值，只记录 TCP 对端 IP；接可信反代时填网关看到的代理精确 IP（逗号分隔）。
# 仅支持 IPv4/IPv6，不支持 CIDR/通配符；反代必须清洗转发头并写入实际客户端来源。
GATEWAY_TRUSTED_PROXY_IPS=
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
ANTHROPIC_VERSION=2023-06-01
UPSTREAM_TIMEOUT_MS=
UPSTREAM_IDLE_TIMEOUT_MS=
# 供应商自动熔断阈值：连续失败（网络/超时/5xx/401/403）N 次自动停用，0 = 关闭。留空默认 3。
PROVIDER_AUTO_DISABLE_THRESHOLD=

# ---- 生产附加（docker-compose.prod.yml 读取；其余服务沿用 docker-compose.yml） ----
# openssl rand -hex 16。环境变量只在数据卷首次初始化时生效；已有库轮换口令
# 应通过 psql 执行 ALTER ROLE mendao WITH PASSWORD '...' 并同步更新本文件，
# 不要为了改口令删除生产数据卷。
POSTGRES_PASSWORD=

# 宿主 Nginx 回源端口；生产编排强制绑定 127.0.0.1，不受 API_HOST_IP /
# GATEWAY_HOST_IP 影响。修改端口时同步更新 Nginx 的 proxy_pass。
API_HOST_PORT=8787
GATEWAY_HOST_PORT=8788

# ---- 超级管理员（root） ----
# 不在此配置账号口令：部署后首次打开控制台会引导创建唯一 root，
# 口令只以 scrypt 哈希存于数据库。存量部署升级时最早创建的可用管理员自动提升为 root。

# 原片链接解析的可选后备密钥；优先使用控制台「媒体模型」保存的加密配置。
# 只在 API 服务端使用；两处均留空时仍可上传原片。
SNAPANY_API_KEY=
