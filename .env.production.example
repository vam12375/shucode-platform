# 生产环境 .env 模板 —— 放到服务器 /opt/shucode-platform/.env（权限 600，不进 git）。
#
# 服务器一次性准备步骤：
#   1. 安装 Docker（含 compose 插件）：curl -fsSL https://get.docker.com | sh
#   2. 登录 ghcr.io（私有镜像）：docker login ghcr.io
#      用户名 = GitHub 用户名；密码 = 勾选 read:packages 的 classic PAT
#   3. 按本文件填好 .env，密钥用下面命令生成：
#        PLATFORM_SECRET_KEY=$(openssl rand -base64 32)
#        POSTGRES_PASSWORD=$(openssl rand -hex 16)
#   4. 部署完成后立即打开控制台，按页面引导创建唯一的超级管理员（root）。
#   5. 云防火墙只放行 22 / 8787 / 8788；5432 不放行（数据库只绑 127.0.0.1）。
#
# 注意：IP 直连（无域名、无 HTTPS）是未定稿的临时形态；域名与 HTTPS 定稿后
# 必须同步更新 PUBLIC_API_ORIGIN / PUBLIC_APP_ORIGIN / GATEWAY_BASE_URL。

# ---- API（控制面） ----
PORT=8787
# 容器内地址由 docker-compose.prod.yml 覆盖为 postgres:5432，这里仅本地排障用。
DATABASE_URL=postgres://mendao:CHANGE_ME@localhost:5432/mendao
MEMORY_DB=
# 客户端与控制台访问的对外地址（临时 IP，域名定稿后替换为 https://…）
PUBLIC_API_ORIGIN=http://124.223.179.63:8787
PUBLIC_APP_ORIGIN=http://124.223.179.63:8787
# 32 字节 base64：openssl rand -base64 32；api 与 gateway 读同一个 .env，天然同值
PLATFORM_SECRET_KEY=
# 无域名留空（跨子域共享 Cookie 时才需要）
COOKIE_DOMAIN=
# 网关公网地址，写入用户级下发的 provider api.baseUrl
GATEWAY_BASE_URL=http://124.223.179.63:8788
GATEWAY_API_TYPE=openai-chat-completions
# 客户端要求 https：无 HTTPS 留空（该字段不下发，客户端回落内置配置）
RELEASE_BASE_URL=
# 控制台由 api 同源托管，无需设置
CONSOLE_DIST_DIR=
PUBLIC_CONSOLE_ORIGIN=
# 由 docker-compose.yml 自动注入(redis://redis:6379/0);此处留空即可
REDIS_URL=

# ---- Gateway（模型网关） ----
GATEWAY_PORT=8788
# 端口直连保持空值，只记录 TCP 对端 IP；接可信反代时填网关看到的代理精确 IP（逗号分隔）。
# 仅支持 IPv4/IPv6，不支持 CIDR/通配符；反代必须清洗转发头并写入实际客户端来源。
GATEWAY_TRUSTED_PROXY_IPS=
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
ANTHROPIC_VERSION=2023-06-01
UPSTREAM_TIMEOUT_MS=
UPSTREAM_IDLE_TIMEOUT_MS=
# 供应商自动熔断阈值：连续失败（网络/超时/5xx/401/403）N 次自动停用，0 = 关闭。留空默认 3。
PROVIDER_AUTO_DISABLE_THRESHOLD=

# ---- 生产附加（docker-compose.prod.yml 读取；其余服务沿用 docker-compose.yml） ----
# openssl rand -hex 16；仅首次建库生效，改口令需删卷重建
POSTGRES_PASSWORD=

# ---- 超级管理员（root） ----
# 不在此配置账号口令：部署后首次打开控制台会引导创建唯一 root，
# 口令只以 scrypt 哈希存于数据库。存量部署升级时最早创建的可用管理员自动提升为 root。
