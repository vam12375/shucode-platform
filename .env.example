# ---- API（控制面） ----
PORT=8787
# Postgres；设置 MEMORY_DB=1 时使用进程内存储（本地体验，重启丢失）
DATABASE_URL=postgres://mendao:mendao@localhost:5432/mendao
MEMORY_DB=
# 对外 origin。PUBLIC_API_ORIGIN 是客户端 SHUCODE_BASE_URL 的目标；
# PUBLIC_APP_ORIGIN 是登录页所在 origin（拆分 app.mendao.chat 时改这里）。
PUBLIC_API_ORIGIN=https://api.mendao.chat
# 可选 HTTPS 媒体 CDN origin；仅本机开发允许 HTTP，留空回退 PUBLIC_API_ORIGIN。
PUBLIC_MEDIA_CDN_ORIGIN=
PUBLIC_APP_ORIGIN=https://api.mendao.chat
# 32 字节 base64 的密钥，用于加密可下发的设备 token。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_SECRET_KEY=
# 生产 .mendao.chat；本地留空
COOKIE_DOMAIN=
# gateway 公网地址，写入用户级下发的 provider api.baseUrl
GATEWAY_BASE_URL=https://gw.mendao.chat
# 平台下发的网关协议：openai-chat-completions（默认）或 anthropic-messages。
# 决定客户端翻译成哪种请求；两种都会被网关透传到同一上游。
GATEWAY_API_TYPE=openai-chat-completions
# Release JSON 下载基址；客户端要求 https，http 时不下发该字段（客户端回落内置配置）
RELEASE_BASE_URL=
# 控制台静态文件目录（pnpm --filter @shucode-platform/console build 产物）
CONSOLE_DIST_DIR=
# 允许携带凭据访问控制台 API 的额外 origin（console.mendao.chat 拆分部署时填写）
PUBLIC_CONSOLE_ORIGIN=
# 只有 TCP 对端命中这些精确 IP 时才解析 CF-Connecting-IP / X-Forwarded-For。
# 直连部署留空；接 Nginx 时填写应用实际看到的 TCP 对端，Docker 转发后可能是网桥 gateway。
# 支持 IPv4/IPv6，不支持 CIDR/通配符；不要因为是私网/Docker 网桥地址就设为可信。
API_TRUSTED_PROXY_IPS=
# 仅当可信代理本身就是 Cloudflare 边缘/cloudflared，且源站无法被绕过时设为 1，
# 才会采用 CF-Connecting-IP；普通 Nginx 回源保持 0，使用清洗后的 XFF。
TRUST_CF_CONNECTING_IP=
# 设备凭据最长寿命（天），0 = 不按年龄过期（仍可随时吊销）。建议生产设置 90。
DEVICE_TOKEN_TTL_DAYS=0
# 管理面域名白名单（逗号分隔，Host 精确匹配）。非空时 /console 只在这些域名可达；
# 与边缘 Access 按域名保护管理入口配合使用。同域部署留空。
CONSOLE_ALLOWED_HOSTS=
# 首次初始化接口（/console/api/setup/*）的 Host 白名单；非空时只在这些 Host 可达。
# 建议指向仅经 Access/VPN 可达的专用初始化域名；留空则与 /console 同域可见。
SETUP_ALLOWED_HOSTS=
# Cloudflare Turnstile 登录人机验证（可选）。两个 key 必须同时配置，留空则不启用。
# 在 Cloudflare Dashboard → Turnstile 创建站点，域名填控制台域名（如 console.example.com）。
# site key 会通过 /console/api/public-config 下发；secret key 只留在服务端。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 可选：覆盖 siteverify 地址（仅本地/代理测试）；生产留空使用 Cloudflare 官方地址。
TURNSTILE_VERIFY_URL=
# root 必须绑定 TOTP 才能进入控制台业务接口（可选加固）。默认关闭；
# 仅在你希望 root 强制双因素时设为 true。
ROOT_MFA_REQUIRED=
# 会话空闲超时（分钟），0 = 只按绝对过期时间判断。默认 30。
SESSION_IDLE_MINUTES=30
# 单实例同时执行 scrypt 的登录请求上限；槽位耗尽直接 429，避免并发打满 CPU。默认 8。
LOGIN_MAX_CONCURRENT=8
# 可选 CSP 违规上报地址（http/https 绝对地址）；留空不下发 report-uri/report-to。
CSP_REPORT_URI=
# HSTS：默认 max-age 一年；includeSubDomains/preload 需确认全部子域长期 HTTPS 后再开。
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=
HSTS_PRELOAD=
# 可选 security.txt 上报渠道（mailto: 或 https URL）；留空则不提供该文件。
SECURITY_CONTACT=
# 首次 root 初始化的请求头口令（x-bootstrap-secret）。生产模式未配置时拒绝初始化；
# 生成：openssl rand -hex 24。内存体验模式（MEMORY_DB=1）可留空。
BOOTSTRAP_SECRET=
# 仅本地开发/测试允许供应商地址使用 http；生产保持空（强制 https）。
ALLOW_INSECURE_UPSTREAM_URLS=
# 允许出站访问私网/回环目标（自建内网上游）；生产默认空，公网上游无需设置。
UPSTREAM_ALLOW_PRIVATE_NETWORKS=
# 可选:Redis(限流共享窗口 + 配置事件总线)。留空时用进程内实现(单实例语义)。
# compose 整栈由 docker-compose.yml 自动注入 redis://redis:6379/0,本地 dev 一般留空。
REDIS_URL=

# ---- Gateway（模型网关） ----
GATEWAY_PORT=8788
# 默认只记录 TCP 对端 IP；仅使用可信反代时填写网关实际看到的代理精确 IP（逗号分隔）。
# 支持 IPv4/IPv6，不支持 CIDR/通配符；不要因为是 Docker 网桥或私网地址就设为可信。
# 反代必须清洗/覆盖 X-Real-IP，并覆盖 X-Forwarded-For 或追加实际对端地址。
GATEWAY_TRUSTED_PROXY_IPS=
# 上游 OpenAI 兼容 base（网关拼 /v1/chat/completions 与 /v1/messages 两个路径）。
# 平台模型目录中的模型名必须与上游真实模型名一致，或用控制台里的 upstream_model 映射。
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
# DeepSeek 官方网页 Search/Fetch 代理（平台设备凭据访问 /v1/tools/*）。
# 密钥只放运行环境，不提交到仓库；费用以 micro 为单位，按成功请求结算。
DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com
DEEPSEEK_TOOLS_API_KEY=
DEEPSEEK_SEARCH_FEE_MICRO=5000
DEEPSEEK_FETCH_FEE_MICRO=5000
ANTHROPIC_VERSION=2023-06-01
# 上游限时（毫秒）：非流式覆盖整个上游响应；流式覆盖到响应头返回。留空默认 120000。
UPSTREAM_TIMEOUT_MS=
# 流式闲置超时（毫秒）：连续无新字节即中断上游并释放额度预留。留空默认 60000。
UPSTREAM_IDLE_TIMEOUT_MS=
# 供应商自动熔断阈值：绑定供应商的请求连续失败（网络/超时/5xx/401/403）N 次即自动停用，
# 控制台「启用」可手动恢复；0 = 关闭自动熔断。留空默认 3。
PROVIDER_AUTO_DISABLE_THRESHOLD=
# DeepSeek 高峰时段：北京时间周一至周五 09:00-12:00 / 14:00-18:00（法定节假日除外）。
# 法定节假日用逗号分隔的日期补充，例如：2026-10-01,2026-10-02；留空只按周末排除。
PEAK_HOURS_HOLIDAYS=
# 控制台「上游供应商」页可按需接入多家上游，密钥用 PLATFORM_SECRET_KEY 加密存储；
# 网关必须与 api 使用同一个 PLATFORM_SECRET_KEY 才能解密转发（两服务都从 .env 读取）。
# 单次请求最多尝试的上游数（渠道池故障转移）；留空默认 3。
GATEWAY_MAX_ATTEMPTS=
# 额度预留 TTL（秒）：超过仍未结算的预留会被 sweeper 回收；留空默认 1800。
GATEWAY_RESERVATION_TTL_SEC=
# 自动熔断供应商的探测间隔（秒）：探测 GET /v1/models，成功后自动恢复调度；0 = 关闭；留空默认 120。
PROVIDER_PROBE_INTERVAL_SEC=
# 结算失败补偿：数据库不可用时把完整 usage 落本地 spool，恢复后由 api/gateway 回灌。
# Docker 编排会挂持久卷到 /app/data/pending-settlements；留空默认 ./data/pending-settlements。
PENDING_SETTLEMENT_DIR=
# 审计 outbox：审计入库失败时落本地队列，后台按 event_id 幂等重放。
# Docker 编排会挂持久卷到 /app/data/audit-outbox；留空默认 ./data/audit-outbox。
AUDIT_OUTBOX_DIR=
# 桌面更新清单已接入真实安装包分发后设为 1；未启用时控制台禁止启用强制更新。
RELEASE_MANIFEST_ENABLED=

# ---- 运维告警（api） ----
# 告警触发时推送的 webhook（POST JSON）。留空只写站内告警事件。
ALERT_WEBHOOK_URL=

# ---- 超级管理员（root） ----
# root 不在 .env 中创建：首次打开控制台会进入初始化页，账号与口令只以哈希写入数据库。
# 新部署必须先在服务器 .env 设置 BOOTSTRAP_SECRET，初始化时在页面填入同一口令；
# 初始化成功后建议从 .env 删除该变量并重启。存量部署升级时，最早创建的可用管理员
# 会自动提升为 root（沿用原密码），此时 root 已存在，初始化接口不会再写入。

# 团队图片、模型片段、合成中间文件与成片的持久目录。Docker compose 已挂载 shucode-media。
MEDIA_STORAGE_DIR=/app/data/media

# 一键视频统一后期：独立 speech 供应商；全部留空时不声明配音能力。
MEDIA_TTS_BASE_URL=
MEDIA_TTS_MODEL=
MEDIA_TTS_VOICE=
MEDIA_TTS_API_KEY=
# API 容器可读的有授权纯音乐文件，可置于既有持久媒体卷；不填则不声明配乐能力。
MEDIA_BGM_PATH=

# 原片链接解析的可选后备密钥；优先使用控制台「媒体模型」保存的加密配置。
# 仅 API 服务使用，不回显；两处均留空时仍可上传原片。
SNAPANY_API_KEY=
